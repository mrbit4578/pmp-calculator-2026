  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/river/(.*)", "destination": "/api/river.js" },
    { "source": "/api/river", "destination": "/api/river.js" },
    { "source": "/api/experiential/(.*)", "destination": "/api/experiential.js" },
